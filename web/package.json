{
  "name": "sdebris-command-center",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/copy-cesium.mjs && next dev",
    "build": "node scripts/copy-cesium.mjs && next build",
    "build:cloudflare": "node scripts/build-static.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cesium": "^1.147.0",
    "driver.js": "^1.10.2",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
