.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local environments and build output
.venv/
*.egg-info/
build/
dist/
site/
web/node_modules/
# Any Next build directory: NEXT_DIST_DIR is set to a different one for the
# end-to-end run, and to throwaway names when a second server is needed.
web/.next*/
web/public/cesium/
*.log
.env*
!.env.example
!web/.env.example
web/test-results/
web/playwright-report/
web/tsconfig.tsbuildinfo
backups/

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Runtime data
data/*.sqlite
# WAL journal sidecars, created alongside the SQLite database at runtime.
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db
data/*.db-wal
data/*.db-shm
data/cache/
data/reports/*.csv
data/reports/*.json

# Environment-specific agent skill links
.agents/
.claude/
web/AGENTS.md
web/CLAUDE.md
