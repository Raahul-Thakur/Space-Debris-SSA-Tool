# Runtime
SDEBRIS_ENV=development
SDEBRIS_DATABASE_URL=sqlite:///data/ontology.sqlite
SDEBRIS_JOB_BACKEND=thread
SDEBRIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SDEBRIS_LOG_LEVEL=INFO

# Production: Supabase JWT verification (required when SDEBRIS_ENV=production)
SDEBRIS_AUTH_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SDEBRIS_AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SDEBRIS_AUTH_AUDIENCE=authenticated

# Production: Supabase Postgres, via the transaction pooler
# SDEBRIS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Production: the deployed frontend, plus an optional pattern for Vercel
# preview deployments (leave unset to refuse them).
# SDEBRIS_CORS_ORIGINS=https://YOUR_PROJECT.vercel.app
# SDEBRIS_CORS_ORIGIN_REGEX=https://YOUR_PROJECT-[a-z0-9-]+\.vercel\.app

# Optional: a durable Redis job queue instead of the in-process thread pool.
# Setting SDEBRIS_JOB_BACKEND=redis also starts a Dramatiq worker in the
# container, and then SDEBRIS_REDIS_URL is required.
# SDEBRIS_JOB_BACKEND=redis
# SDEBRIS_REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Frontend values belong in web/.env.local
# NEXT_PUBLIC_SDEBRIS_API_URL=https://YOUR_API.onrender.com
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
